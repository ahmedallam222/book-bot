{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "ESNext",
    "moduleResolution":  "bundler",
    "esModuleInterop":   true,
    "strict":            true,
    "skipLibCheck":      true,
    "outDir":            "./dist",
    "rootDir":           ".",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include":  ["server/**/*", "shared/**/*", "script/**/*"],
  "exclude":  ["node_modules", "dist", "client", "vite.config.ts"]
}
