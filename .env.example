# ══════════════════════════════════════════════════════════════
# خلاصة الكتب — Environment Variables
# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── إلزامي ─────────────────────────────────────────────────────
# Telegram Bot Token — من @BotFather
BOT_TOKEN=

# PostgreSQL Connection String
DATABASE_URL=postgresql://bookbot:bookbot_pass@db:5432/bookbot

# Redis Connection String
REDIS_URL=redis://redis:6379

# Firecrawl API Key — https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── موصى به ────────────────────────────────────────────────────
# Mistral AI Key — يحسّن دقة التحقق من PDF (اختياري)
MISTRAL_API_KEY=

# IDs المشرفين على تيليغرام (مفصولة بفاصلة) — أرقام Telegram numeric IDs فقط
# مثال: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# IDs المستخدمين المحظورين عند الإقلاع (مفصولة بفاصلة)
BANNED_IDS=

# Secret قوي للـ Dashboard auth (يُنصح: openssl rand -hex 32)
DASHBOARD_SECRET=

# Origin المسموح له بالوصول للـ dashboard API (CORS)
DASHBOARD_ORIGIN=http://localhost:5000

# رابط الـ Dashboard الذي يظهر في رسالة /admin داخل البوت (اختياري)
# يجب أن يبدأ بـ http:// أو https://
DASHBOARD_URL=

# ── الخادم ──────────────────────────────────────────────────────
# منفذ HTTP server (الافتراضي: 5000)
PORT=5000

# بيئة التشغيل (production يخفي debug logs)
NODE_ENV=production

# ── الـ Logging ────────────────────────────────────────────────
# مستوى السجل: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# مسار ملف الـ logs (فارغ = stdout فقط)
LOG_FILE=

# ── PDF Validation Thresholds ─────────────────────────────────
# عتبات التحقق من تطابق محتوى الـ PDF مع اسم الكتاب
# قيم بين 0 و 1 — راجع server/bot/config.ts للتفاصيل
PDF_VALIDATE_ACCEPT_THRESHOLD=0.40
PDF_VALIDATE_REJECT_THRESHOLD=0.12
