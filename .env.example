# ══════════════════════════════════════════════════════════════
# خلاصة الكتب — Environment Variables
# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── إلزامي ─────────────────────────────────────────────────────
# Telegram Bot Token — من @BotFather
BOT_TOKEN=

# PostgreSQL Connection String
DATABASE_URL=postgresql://bookbot:bookbot_pass@db:5432/bookbot

# Redis Connection String
REDIS_URL=redis://redis:6379

# Firecrawl API Key — https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── موصى به ────────────────────────────────────────────────────
# Mistral AI Key — يحسّن دقة التحقق من PDF (اختياري)
MISTRAL_API_KEY=

# IDs المشرفين على تيليغرام (مفصولة بفاصلة)
ADMIN_IDS=

# Secret قوي للـ Dashboard (يُنصح باستخدام: openssl rand -hex 32)
DASHBOARD_SECRET=

# Origin المسموح له بالوصول للـ dashboard API
DASHBOARD_ORIGIN=http://localhost:5000

# ── ضبط متقدم ──────────────────────────────────────────────────
# عدد الـ Workers المتوازية (الافتراضي: 3)
WORKER_COUNT=3

# مجلد الملفات المؤقتة
TEMP_DIR=/tmp/kholasa_books

# بيئة التشغيل (production يخفي debug logs)
NODE_ENV=production

# مواقع إضافية غير موثوقة (مفصولة بفاصلة)
UNRELIABLE_DOMAINS_EXTRA=

# مواقع عرض فقط — لا يمكن تحميل PDF منها (مفصولة بفاصلة)
VIEWER_ONLY_DOMAINS_EXTRA=
