# ══════════════════════════════════════════════════════════════
# خلاصة الكتب — Environment Variables
# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── إلزامي ─────────────────────────────────────────────────────
# Telegram Bot Token — من @BotFather
BOT_TOKEN=

# PostgreSQL password — استعمل قيمة قوية. compose يقرأها مباشرة لتشغيل الـ
# DB ولبناء DATABASE_URL أيضاً → غيِّرها هنا فقط، لا تكتبها في موضعَين.
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=change_me_strong_password

# PostgreSQL Connection String — للاستخدام المحلي (npm run dev) فقط.
# في Docker يُبنى تلقائياً من POSTGRES_PASSWORD أعلاه.
DATABASE_URL=postgresql://bookbot:${POSTGRES_PASSWORD}@db:5432/bookbot

# Redis Connection String
REDIS_URL=redis://redis:6379

# Firecrawl API Key — https://firecrawl.dev
FIRECRAWL_API_KEY=

# nano-banana API Key — لميزة /img (توليد الصور بالـ AI). اتركه فارغاً
# يعطّل ميزة /img تماماً (الـ command يرد برسالة "غير مفعّلة"). الـ endpoint
# الافتراضي يستخدم gold-newt-367030.hostingersite.com.
NANO_BANANA_API_KEY=

# (اختياري) عدّل endpoint nano-banana لو استضفت بنفسك بديل API-compatible.
# NANO_BANANA_ENDPOINT=https://gold-newt-367030.hostingersite.com/nano.php

# (اختياري) عدد الصور اليومي لكل مستخدم — افتراضي 5.
# IMAGE_DAILY_LIMIT=5

# ── موصى به ────────────────────────────────────────────────────
# Mistral AI Key — يحسّن دقة التحقق من PDF (اختياري)
MISTRAL_API_KEY=

# IDs المشرفين على تيليغرام (مفصولة بفاصلة) — أرقام Telegram numeric IDs فقط
# مثال: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# توكن بوت تيليغرام ثانٍ (من @BotFather) لتشغيل وكيل الذكاء الاصطناعي للإدارة (Admin AI Agent).
# اختياري — لو تركته فارغًا الـ Agent يفضل معطلًا تمامًا. لا تستخدم نفس BOT_TOKEN الرئيسي،
# تيليغرام يسمح بـ polling واحد لكل توكن. فقط المشرفون في ADMIN_IDS يستطيعون التحاور معه.
ADMIN_BOT_TOKEN=

# AgentRouter (agentrouter.org) API key — موزِّع OpenAI-compatible يقدِّم
# عدة frontier models (Claude Opus/Haiku، DeepSeek v4 Pro/Flash، GLM 5.1) بمفتاح واحد.
# يُستخدم في chain الـ Admin AI Agent بعد Cloudflare كـ paid fallback.
# اختياري — لو فارغ، الـ Agent يكتفي بـ Cloudflare + Cerebras + Groq.
# احصل على المفتاح: https://agentrouter.org/console/token
AGENTROUTER_API_KEY=

# IDs المستخدمين المحظورين عند الإقلاع (مفصولة بفاصلة)
BANNED_IDS=

# Secret قوي للـ Dashboard auth (يُنصح: openssl rand -hex 32)
DASHBOARD_SECRET=

# Origin المسموح له بالوصول للـ dashboard API (CORS)
DASHBOARD_ORIGIN=http://localhost:5000

# رابط الـ Dashboard الذي يظهر في رسالة /admin داخل البوت (اختياري)
# يجب أن يبدأ بـ http:// أو https://
DASHBOARD_URL=

# ── الخادم ──────────────────────────────────────────────────────
# منفذ HTTP server (الافتراضي: 5000)
PORT=5000

# ربط منفذ Docker على الـ host:
#   - 127.0.0.1 (افتراضي، آمن): الـ dashboard متاح فقط من نفس الـ host
#     مع reverse proxy (Nginx/Caddy) وHTTPS أمامه
#   - 0.0.0.0: مكشوف على الإنترنت (يتطلب DASHBOARD_SECRET قوياً)
BOT_PORT_BIND=127.0.0.1

# داخل الـ container (أو local dev بدون docker): host الذي يستمع عليه Express.
#   - 0.0.0.0 (افتراضي): يقبل من أي interface (مطلوب داخل docker)
#   - 127.0.0.1: لو تشغيل local بدون docker وتريد منعه عن الشبكة المحلية
BIND_HOST=0.0.0.0

# trust proxy لـ Express — يحدد عدد proxy hops التي يثق بها req.ip
#   - 0 (افتراضي، آمن): لا proxy، يأخذ socket address مباشرة
#   - 1: خلف Nginx/Caddy على نفس الجهاز
#   - 2: خلف Cloudflare/CDN ثم Nginx
# ضبط غلط = ipRateLimit يبني المفاتيح على IP الـ proxy = حظر كل المستخدمين
TRUST_PROXY=0

# بيئة التشغيل (production يخفي debug logs)
NODE_ENV=production

# ── الـ Logging ────────────────────────────────────────────────
# مستوى السجل: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# مسار ملف الـ logs (فارغ = stdout فقط)
LOG_FILE=

# ── PDF Validation Thresholds ─────────────────────────────────
# عتبات التحقق من تطابق محتوى الـ PDF مع اسم الكتاب
# قيم بين 0 و 1 — راجع server/bot/config.ts للتفاصيل
PDF_VALIDATE_ACCEPT_THRESHOLD=0.40
PDF_VALIDATE_REJECT_THRESHOLD=0.12
